rules_version = '2';

// =============================================================================
// YET, regole di sicurezza Firestore
//
// QUESTE REGOLE SONO L'UNICA PROTEZIONE VERA.
//
// `src/config/admins.js` serve solo a mostrare o nascondere l'interfaccia:
// chiunque apra la console del browser può montare la pagina /admin lo stesso.
// A fermarlo c'è solo quello che sta scritto qui, perché queste condizioni
// girano sui server di Google e non su un computer che l'utente controlla.
//
// Da cui la conseguenza pratica: cambiare la lista degli admin in
// src/config/admins.js NON cambia i permessi. Vanno modificate entrambe le
// liste e va ri-pubblicato questo file.
//
// COME PUBBLICARLE
//   console Firebase -> Firestore Database -> scheda "Regole" -> incolla -> Pubblica
//   oppure:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // ALLOWLIST DEGLI AMMINISTRATORI
    //
    // Questa lista deve restare IDENTICA a ADMIN_EMAILS in
    // src/config/admins.js. Le due non sono collegate da nulla: se le fai
    // divergere, il sito mostrerà il pannello a qualcuno che poi si vedrà
    // rifiutare ogni salvataggio con "permission-denied".
    //
    // Vanno scritte in MINUSCOLO: il confronto qui sotto abbassa la mail del
    // token, non queste costanti.
    //
    // ⚠️  Dopo ogni modifica le regole vanno RIPUBBLICATE (console Firebase →
    //     Firestore → Regole → Pubblica). Cambiare il file nel repo non ha
    //     alcun effetto sul database.
    // -------------------------------------------------------------------------
    function adminEmails() {
      return [
        'fedefas.210@gmail.com',
        'greta.dal19@gmail.com',
        'lucafrancesco.rollino@gmail.com',
        'mattiapapa.075@gmail.com'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Il controllo su email_verified non è pignoleria.
    //
    // Il modello di minaccia è questo: la nostra chiave di autorizzazione è
    // l'INDIRIZZO EMAIL, non l'uid. Con Google l'email è sempre verificata,
    // quindi la condizione non costa niente. Ma se un domani venisse attivato
    // un secondo metodo di accesso (email/password, un provider OIDC
    // qualsiasi), chiunque potrebbe registrarsi dichiarando l'indirizzo di un
    // admin e ottenere un token con quella email dentro. Il flag è ciò che
    // impedisce a quella modifica futura di aprire un buco in silenzio.
    function isAdmin() {
      return isSignedIn()
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in adminEmails();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // I dati in arrivo con una create o una update.
    function incoming() {
      return request.resource.data;
    }

    // Il documento com'è ADESSO sul server, prima della scrittura.
    function stored() {
      return resource.data;
    }

    // =========================================================================
    // users/{uid}, i profili dei membri
    //
    // ISCRIZIONE CON APPROVAZIONE.
    // Un profilo nasce `status: 'pending'` e resta invisibile finché un admin
    // non lo approva. Le tre regole che reggono tutto il meccanismo:
    //
    //   1. in creazione lo status DEVE essere 'pending', non ci si
    //      auto-approva;
    //   2. il proprietario può modificare i propri dati ma NON il proprio
    //      status, altrimenti gli basterebbe una richiesta scritta a mano;
    //   3. un admin può cambiare lo status e SOLO quello, non può riscrivere
    //      la bio di qualcun altro.
    //
    // LETTURA: pubblica solo per i profili approvati. Chi è in attesa lo
    // vedono lui stesso e gli admin, e nessun altro: una richiesta rifiutata
    // non deve lasciare in giro il nome di chi l'aveva fatta.
    // =========================================================================
    match /users/{uid} {

      // Attenzione al funzionamento su QUERY: Firestore non valuta la regola
      // documento per documento, ma pretende che la query sia costruita in
      // modo che ogni risultato la soddisfi per forza. Ecco perché
      // listUsers() in src/lib/db.js filtra su status == 'approved': senza
      // quel where la query verrebbe rifiutata in blocco, non "filtrata".
      allow read: if resource.data.status == 'approved'
                  || isOwner(uid)
                  || isAdmin();

      // Le sole chiavi ammesse. hasOnly() è la metà che conta: senza,
      // chiunque potrebbe attaccare al proprio profilo campi arbitrari
      // (`isAdmin: true`, un payload da megabyte) e ce li ritroveremmo in
      // pancia al database.
      function usersKeysOk() {
        return incoming().keys().hasOnly(
          ['displayName', 'location', 'bio', 'photoURL', 'socials', 'role',
           'status', 'createdAt', 'updatedAt']
        );
      }

      function displayNameOk() {
        return incoming().displayName is string
            && incoming().displayName.size() >= 1
            && incoming().displayName.size() <= 80;
      }

      // Il limite di 300 deve esistere QUI, non solo nel contatore della
      // pagina Join: il contatore è un aiuto per chi scrive, non un controllo.
      // Chi scrive a mano una richiesta al database non lo incontra nemmeno.
      // Se cambi il numero, cambialo anche in BIO_MAX dentro src/lib/db.js.
      // Da dove scrive un membro. Facoltativo in tutti i sensi: può essere la
      // stringa vuota e può proprio non esserci.
      //
      // L'assenza va ammessa esplicitamente, e non è pignoleria: le scritture
      // parziali (reconcileUserRole manda solo role, status e updatedAt)
      // producono un documento fuso che, se il profilo è nato prima di questo
      // campo, non lo contiene. Pretenderlo qui bloccherebbe quelle scritture
      // con un permission-denied, lo stesso inciampo già visto con `status`,
      // che allora costò un pomeriggio. Un campo aggiunto dopo si tratta come
      // opzionale, sempre.
      function locationOk() {
        return !('location' in incoming())
            || (incoming().location is string && incoming().location.size() <= 60);
      }

      function bioOk() {
        return incoming().bio is string
            && incoming().bio.size() <= 300;
      }

      // Stringa vuota ammessa (il campo è opzionale). Se valorizzata deve
      // essere un URL http/https: senza questo controllo si potrebbe salvare
      // un `javascript:` che diventerebbe pericoloso il giorno in cui qualcuno
      // usasse quel valore come href invece che come src.
      // La foto profilo, nelle sue due forme.
      //
      // 1. un indirizzo http(s) incollato, poche centinaia di caratteri;
      // 2. una foto caricata dall'utente e compressa dal browser, che arriva
      //    come data URL, cioè una stringa da qualche decina di migliaia di
      //    caratteri.
      //
      // I data URL ammessi sono SOLO jpeg, png e webp. Niente svg: un SVG è
      // XML e può contenere <script>. Qui finisce dentro un <img>, dove non
      // partirebbe, ma basta che un domani qualcuno lo apra in una scheda
      // perché parta. Un elenco chiuso costa meno di quel rischio.
      //
      // Il tetto di 100.000 caratteri non è arbitrario: il client comprime
      // l'avatar a 320px e circa 70 KB, e questo lascia margine senza aprire
      // la porta a un documento utente da mezzo megabyte, che verrebbe poi
      // scaricato per intero dalla pagina Membri per ogni singolo iscritto.
      // Se cambi il numero, cambia PHOTO_MAX_CHARS in src/lib/db.js.
      function photoOk() {
        return incoming().photoURL is string
            && incoming().photoURL.size() <= 100000
            && (incoming().photoURL == ''
                || incoming().photoURL.matches('(?i)https?://.*')
                || incoming().photoURL.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
      }

      function socialsOk() {
        return incoming().socials is map
            && incoming().socials.keys().hasOnly(['linkedin', 'instagram', 'other'])
            && (!('linkedin' in incoming().socials)
                || (incoming().socials.linkedin is string && incoming().socials.linkedin.size() <= 200))
            && (!('instagram' in incoming().socials)
                || (incoming().socials.instagram is string && incoming().socials.instagram.size() <= 200))
            && (!('other' in incoming().socials)
                || (incoming().socials.other is string && incoming().socials.other.size() <= 200));
      }

      // `role` è scritto dal client ma NON è deciso dal client.
      //
      // Serve alla pagina Membri per separare la sezione "Chi organizza" da
      // quella dei membri: i documenti users non contengono l'email (l'
      // informativa privacy promette che non venga mai pubblicata), quindi
      // senza questo campo non ci sarebbe modo di distinguerli.
      //
      // La riga che lo rende sicuro è l'uguaglianza: il valore deve
      // corrispondere ESATTAMENTE all'esito del confronto fra l'email del
      // token e la allowlist. Chi non è in lista e prova a salvarsi
      // `role: 'admin'` non ottiene un campo ignorato, si vede rifiutare
      // l'intera scrittura. E chi È in lista non può nascondersi mettendo
      // 'member': la pagina resta onesta in entrambe le direzioni.
      function roleOk() {
        return incoming().role == (isAdmin() ? 'admin' : 'member');
      }

      function statusValid() {
        return incoming().status in ['pending', 'approved', 'rejected'];
      }

      // Lo status che il documento ha ADESSO, con una risposta sensata anche
      // quando il campo non c'è.
      //
      // Serve ai profili nati prima che l'approvazione esistesse. Su di loro
      // `stored().status` non è "vuoto": è un accesso a una chiave assente, e
      // in Security Rules quello fa fallire l'INTERA espressione. Senza questa
      // funzione, chi si era iscritto prima non riuscirebbe più a salvare il
      // proprio profilo, e l'errore direbbe solo "permission-denied", senza
      // lasciar capire che il colpevole è un campo che non c'è.
      //
      // Il valore di ripiego è quello che il profilo avrebbe avuto se fosse
      // nato oggi, e il client scrive esattamente lo stesso (vedi
      // saveUserProfile in src/lib/db.js): la migrazione avviene al primo
      // salvataggio, senza uno script e senza toccare il database a mano.
      function storedStatus() {
        return 'status' in stored()
             ? stored().status
             : (isAdmin() ? 'approved' : 'pending');
      }

      function usersShapeOk() {
        return usersKeysOk() && displayNameOk() && locationOk() && bioOk()
            && photoOk() && socialsOk() && roleOk() && statusValid();
      }

      // --- creazione --------------------------------------------------------
      // Gli admin entrano già approvati: farli passare dalla loro stessa coda
      // sarebbe solo un giro a vuoto, e al primo avvio non ci sarebbe nessuno
      // ad approvare il primo di loro.
      allow create: if isOwner(uid)
                    && usersShapeOk()
                    && incoming().createdAt == request.time
                    && incoming().status == (isAdmin() ? 'approved' : 'pending');

      // --- modifica da parte del proprietario -------------------------------
      // createdAt non deve poter cambiare: è il campo su cui /membri ordina
      // l'elenco, e senza questo vincolo chiunque potrebbe riscriverlo per
      // mettersi in cima. Il confronto con stored() (il documento com'è ADESSO
      // sul server) è ciò che rende il vincolo non aggirabile.
      //
      // E soprattutto: lo status resta quello che era. È la riga che rende
      // l'approvazione una cosa seria invece che una formalità.
      allow update: if isOwner(uid)
                    && usersShapeOk()
                    && incoming().createdAt == stored().createdAt
                    && incoming().status == storedStatus()
                    && incoming().updatedAt == request.time;

      // --- approvazione o rifiuto da parte di un admin ----------------------
      // diff().affectedKeys() elenca i campi che la scrittura cambia davvero.
      // Limitarlo a status e updatedAt fa sì che un admin possa decidere chi
      // entra ma non riscrivere la presentazione di qualcun altro: un potere
      // che non serve a niente e che tanto vale non concedere.
      allow update: if isAdmin()
                    && incoming().diff(stored()).affectedKeys()
                         .hasOnly(['status', 'updatedAt'])
                    && statusValid()
                    && incoming().updatedAt == request.time;

      // Solo il proprietario può cancellarsi. Nemmeno un admin: cancellare il
      // profilo di un altro non è un'operazione che deve esistere da qui
      // per tenere qualcuno fuori c'è il rifiuto, che è reversibile.
      allow delete: if isOwner(uid);
    }

    // =========================================================================
    // news/{id}, le notizie
    //
    // Lettura pubblica, comprese le bozze.
    //
    // ATTENZIONE, ed è una scelta consapevole: `published: false` NASCONDE la
    // notizia dall'interfaccia, non la rende segreta. La query della home
    // filtra su published==true, ma chiunque può interrogare la collection
    // senza quel filtro e leggere le bozze. Rendere le bozze illeggibili
    // richiederebbe due collection separate.
    // Regola pratica: non scrivere in una bozza niente che non possa diventare
    // pubblico.
    // =========================================================================
    match /news/{newsId} {

      allow read: if true;

      function newsKeysOk() {
        return incoming().keys().hasOnly(
          ['title', 'body', 'attachments', 'authorUid', 'authorName',
           'createdAt', 'published']
        );
      }

      // Sugli allegati il controllo si ferma al tipo e alla lunghezza, e va
      // detto perché invece di lasciarlo scoprire.
      //
      // Le Security Rules non sanno iterare una lista: non esiste un "per ogni
      // elemento", quindi non è possibile verificare qui dentro che ogni voce
      // sia una mappa con quelle tre chiavi e un URL http(s). Si può controllare
      // che sia una lista e quanto è lunga, e basta.
      //
      // Regge lo stesso, perché su news il modello di minaccia è diverso da
      // quello su users: scrivere qui può SOLO un admin autenticato e nella
      // allowlist. Il rischio non è l'estraneo che inietta dati, è
      // l'amministratore che sbaglia, e per quello bastano la validazione del
      // form e normalizeAttachments in lib/db.js.
      //
      // La difesa che conta davvero è comunque un'altra e sta altrove: gli URL
      // vengono ricontrollati AL MOMENTO DI MOSTRARLI (safeUrl in
      // src/lib/attachments.js), perché è lì che un `javascript:` diventerebbe
      // pericoloso, ed è l'unico punto che protegge anche i dati scritti prima
      // di questa regola o a mano dalla console.
      function attachmentsOk() {
        return !('attachments' in incoming())
            || (incoming().attachments is list && incoming().attachments.size() <= 8);
      }

      function newsShapeOk() {
        return newsKeysOk()
            && attachmentsOk()
            && incoming().title is string
            && incoming().title.size() >= 1
            && incoming().title.size() <= 200
            && incoming().body is string
            && incoming().body.size() >= 1
            && incoming().body.size() <= 20000
            && incoming().published is bool;
      }

      // authorUid deve essere l'uid di chi scrive: un admin non può firmare
      // una notizia a nome di un altro.
      allow create: if isAdmin()
                    && newsShapeOk()
                    && incoming().authorUid == request.auth.uid
                    && incoming().createdAt == request.time;

      // In modifica restano fissi autore e data: cambiarli riscriverebbe la
      // storia del feed, che è il senso di avere una data.
      allow update: if isAdmin()
                    && newsShapeOk()
                    && incoming().authorUid == stored().authorUid
                    && incoming().createdAt == stored().createdAt;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // media/{id}, i file caricati dentro le notizie
    //
    // Un documento per file, e il motivo è il limite di 1 MiB per documento:
    // dentro la notizia quel megabyte andrebbe diviso fra il testo e tutte le
    // foto, qui invece ogni immagine ce l'ha tutto per sé.
    //
    // LETTURA PUBBLICA, ed è voluto: questi file compaiono dentro notizie
    // pubbliche, quindi chiunque veda la notizia deve poter vedere l'allegato.
    // Regola pratica per chi carica: qui dentro va solo roba destinata a
    // diventare pubblica.
    //
    // SCRITTURA SOLO AGLI ADMIN, come per le notizie: sono la stessa azione.
    //
    // Sulla DIMENSIONE non c'è una regola, e non è una dimenticanza: il tetto
    // di 1 MiB lo impone Firestore stesso, su ogni documento, e una scrittura
    // che lo supera viene rifiutata dal server prima ancora di arrivare qui.
    // Riscriverlo nelle regole aggiungerebbe un numero da tenere allineato
    // senza aggiungere protezione.
    // =========================================================================
    match /media/{mediaId} {

      allow read: if true;

      function mediaShapeOk() {
        return incoming().keys().hasOnly(
          ['dataUrl', 'contentType', 'name', 'width', 'height', 'bytes',
           'authorUid', 'createdAt']
        )
            && incoming().dataUrl is string
            // Elenco chiuso dei tipi, e NIENTE svg: un SVG può contenere
            // <script>, e questi file finiscono dentro un tag <img> di una
            // pagina pubblica. È la ragione per cui l'elenco è scritto a mano
            // invece di accettare 'image/*'.
            && incoming().dataUrl.matches(
                 'data:(image/(jpeg|png|webp|gif|avif)|application/pdf);base64,.*')
            && incoming().contentType is string
            && incoming().name is string
            && incoming().name.size() <= 120
            && incoming().bytes is int;
      }

      allow create: if isAdmin()
                    && mediaShapeOk()
                    && incoming().authorUid == request.auth.uid
                    && incoming().createdAt == request.time;

      // Nessun update: un file non si modifica, si sostituisce. Non
      // permetterlo toglie di mezzo una classe intera di domande su cosa possa
      // cambiare e cosa no.
      allow update: if false;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // TUTTO IL RESTO: NEGATO
    //
    // Non è ridondante rispetto al comportamento predefinito di Firestore.
    // È una dichiarazione di intenti che vale per il futuro: la collection che
    // qualcuno creerà fra sei mesi (eventi, commenti, iscrizioni) nasce chiusa,
    // e per aprirla bisognerà passare da questo file e pensarci. Senza questa
    // riga, chi aggiunge una `match` nuova può dimenticarsi le condizioni e
    // non se ne accorge nessuno.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
