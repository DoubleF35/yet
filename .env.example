# =============================================================================
# Config Firebase — copia questo file in `.env` e riempi i valori.
#
#     cp .env.example .env
#
# Dove trovarli: console.firebase.google.com -> il tuo progetto ->
# ingranaggio "Impostazioni progetto" -> scheda "Generali" -> in fondo,
# sezione "Le tue app" -> app web -> "Configurazione SDK" -> "Configurazione".
# Da lì copi i campi dell'oggetto firebaseConfig, uno per uno, qui sotto.
#
# NOTA SULLA SICUREZZA: queste chiavi NON sono segrete. Finiscono comunque nel
# bundle JavaScript che il browser scarica, ed è normale — Firebase è progettato
# così. Quello che protegge davvero i dati sono le regole in firestore.rules,
# più la lista dei domini autorizzati in Authentication -> Settings ->
# Authorized domains. Teniamo comunque il file fuori dal repo (.gitignore) per
# non legare il codice pubblico a un progetto Firebase specifico.
#
# Il prefisso VITE_ è obbligatorio: Vite espone al client SOLO le variabili che
# iniziano così. Se ne aggiungi una senza prefisso, `import.meta.env` la ignora.
# Dopo ogni modifica a .env riavvia `npm run dev` — non c'è hot reload sulle env.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opzionale: solo se hai attivato Google Analytics sul progetto Firebase.
# Lasciala vuota se non lo usi, il codice la ignora.
VITE_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# LA POSTA (facoltativa)
#
# L'indirizzo della web app di Google Apps Script che manda le due mail quando
# arriva una candidatura: una a YET e una a chi si e' iscritto. Il codice dello
# script sta in scripts/posta.gs e il README spiega come pubblicarlo.
#
# Se la lasci vuota il sito funziona identico e non manda niente: le
# candidature arrivano comunque nel pannello, che e' il posto dove vivono.
#
# NON E' UN SEGRETO, come le chiavi qui sopra: finisce nel bundle. A impedire
# che qualcun altro la usi non e' il fatto che sia nascosta, e' che lo script
# pretende un token di accesso valido e decide da solo a chi scrivere.
# =============================================================================

VITE_URL_POSTA=
