# --- segreti -----------------------------------------------------------
# .env contiene la config Firebase reale. NON deve mai finire nel repo.
# In produzione le chiavi arrivano dai GitHub Secrets (vedi deploy.yml).
.env
.env.local
.env.*.local
!.env.example

# --- dipendenze e build ------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# --- editor / OS -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- log ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- firebase ----------------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log

# --- backup e chiavi di servizio ---------------------------------------
# I backup contengono dati personali dei membri: restano sul tuo computer.
backups/
# La chiave di servizio scavalca OGNI regola di sicurezza. Non deve mai
# finire in un repo, nemmeno privato.
*serviceaccount*.json
*service-account*.json
firebase-adminsdk-*.json

# --- foto degli eventi -------------------------------------------------
# Gli scatti originali NON entrano nel repo: un JPEG da fotocamera pesa
# 4-8 MB e git non dimentica, resterebbero nella storia per sempre anche
# cancellandoli dopo. `npm run foto` ne ricava le WebP in public/eventi/,
# che pesano un ventesimo e QUELLE si committano.
# Il pattern e' foto-originali/* e non foto-originali/: git non rientra in una
# cartella gia' scartata, quindi con la seconda forma la riga di eccezione qui
# sotto non avrebbe alcun effetto e LEGGIMI.txt resterebbe invisibile.
foto-originali/*
!foto-originali/LEGGIMI.txt
