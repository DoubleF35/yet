# --- segreti -----------------------------------------------------------
# .env contiene la config Firebase reale. NON deve mai finire nel repo.
# In produzione le chiavi arrivano dai GitHub Secrets (vedi deploy.yml).
.env
.env.local
.env.*.local
!.env.example

# --- dipendenze e build ------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# --- editor / OS -------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- log ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- firebase ----------------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log

# --- backup e chiavi di servizio ---------------------------------------
# I backup contengono dati personali dei membri: restano sul tuo computer.
backups/
# La chiave di servizio scavalca OGNI regola di sicurezza. Non deve mai
# finire in un repo, nemmeno privato.
*serviceaccount*.json
*service-account*.json
firebase-adminsdk-*.json
